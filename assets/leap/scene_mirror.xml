    <light name="fill" pos="0.1 -0.5 0.5" dir="0 0.6 -0.6" directional="false"
           diffuse="0.28 0.28 0.32" castshadow="false"/>
    <geom name="stage" type="box" size="0.6 0.6 0.02" pos="0.05 0 -0.05" material="stage"/>
